<?xml version="1.0"?>
<labwc_config>

  <placement>
    <policy>automatic</policy>
  </placement>

  <theme>
    <name>canopy</name>
    <titlebar>
      <layout>close,iconify,max:</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <dropShadows>yes</dropShadows>
    <cornerRadius>10</cornerRadius>
    <font name="Cantarell" size="10" weight="bold"/>
    <padding>
      <titlebar>
        <height>30</height>
        <paddingHeight>4</paddingHeight>
        <paddingWidth>6</paddingWidth>
      </titlebar>
    </padding>
  </theme>

  <desktops number="4" />

  <keyboard>
    <default/>

    <!-- Super on its own toggles the Canopy launcher.
         onRelease="yes" fires only when Super is pressed and released without
         another key, so Super+<key> shortcuts keep working and the shell never
         tries to grab a modifier from the compositor.
         NOTE: the ipc client needs the same config flag as the running shell,
         otherwise it cannot locate the instance. -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="canopy msg panel-toggle launcher" />
    </keybind>

    <keybind key="W-Return">
      <action name="Execute" command="alacritty" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="canopy msg session lock" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>

    <!-- Screenshots: Flameshot is Canopy's default capture tool; the helper
         falls back to grim/slurp when it is not installed. -->
    <keybind key="Print">
      <action name="Execute" command="sh -c 'exec $HOME/.local/bin/canopy-screenshot area'" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="sh -c 'exec $HOME/.local/bin/canopy-screenshot screen'" />
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute" command="sh -c 'exec $HOME/.local/bin/canopy-screenshot area'" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="W-Tab">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>

    <keybind key="XF86_AudioLowerVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ -5%" />
    </keybind>
    <keybind key="XF86_AudioRaiseVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ +5%" />
    </keybind>
    <keybind key="XF86_AudioMute">
      <action name="Execute" command="pactl set-sink-mute @DEFAULT_SINK@ toggle" />
    </keybind>

    <numlock>on</numlock>
  </keyboard>



</labwc_config>
