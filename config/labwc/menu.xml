<?xml version="1.0"?>
<!--
  Canopy root menu (right-click on the desktop).
  Menus are the compositor's; the shell owns the panel, dock and launcher.
-->
<openbox_menu>

  <menu id="root-menu" label="Canopy">
    <item label="Application Launcher">
      <action name="Execute" command="canopy msg panel-toggle launcher"/>
    </item>
    <item label="Quick Settings">
      <action name="Execute" command="canopy msg panel-toggle control-center"/>
    </item>
    <item label="Settings">
      <action name="Execute" command="canopy msg settings-open"/>
    </item>
    <separator/>
    <menu id="terminal-menu" label="Terminal">
      <item label="Alacritty">
        <action name="Execute" command="alacritty"/>
      </item>
      <item label="Kitty">
        <action name="Execute" command="kitty"/>
      </item>
      <item label="Foot">
        <action name="Execute" command="foot"/>
      </item>
    </menu>
    <menu id="files-menu" label="Files">
      <item label="Home">
        <action name="Execute" command="xdg-open ~"/>
      </item>
      <item label="Downloads">
        <action name="Execute" command="xdg-open ~/Downloads"/>
      </item>
    </menu>
    <separator/>
    <item label="Screenshot">
      <action name="Execute" command="canopy msg screenshot-region"/>
    </item>
    <item label="Lock Screen">
      <action name="Execute" command="canopy msg session lock"/>
    </item>
    <separator/>
    <item label="Window">
      <action name="Execute" command="canopy msg panel-toggle launcher"/>
    </item>
    <item label="Reconfigure">
      <action name="Reconfigure"/>
    </item>
    <item label="Session">
      <action name="Execute" command="canopy msg panel-toggle session"/>
    </item>
    <menu id="session-menu" label="Power">
      <item label="Lock">
        <action name="Execute" command="canopy msg session lock"/>
      </item>
      <item label="Suspend">
        <action name="Execute" command="canopy msg session suspend"/>
      </item>
      <item label="Log Out">
        <action name="Exit"/>
      </item>
      <item label="Restart">
        <action name="Execute" command="systemctl reboot"/>
      </item>
      <item label="Shut Down">
        <action name="Execute" command="systemctl poweroff"/>
      </item>
    </menu>
  </menu>

</openbox_menu>