[Desktop Entry]
Type=Application
Name=Canopy
GenericName=Desktop Shell
Comment=Canopy desktop environment by Xytro Labs
Exec=canopy --daemon
Icon=canopy
Terminal=false
Categories=Settings;DesktopSettings;
StartupNotify=false
Actions=Settings;
Keywords=desktop;shell;wayland;canopy;

[Desktop Action Settings]
Name=Open Settings
Exec=sh -c "canopy msg settings-open || { canopy --daemon && canopy msg settings-open; }"
