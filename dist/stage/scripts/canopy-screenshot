#!/bin/sh
# canopy-screenshot — capture with Canopy's own screenshot stack.
#
#   canopy-screenshot area|screen|window|annotate [options]
#
# The shell owns capture (ext-image-copy-capture / wlr-screencopy), so it is
# preferred. When the shell is not running - or a compositor lacks the protocol -
# this falls back to grim/slurp so the key still does something useful.
set -eu

MODE="${1:-area}"
shift 2>/dev/null || true

screen_dir() { printf '%s\n' "${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"; }

save_via_shell() {
    _cmd="screenshot-region"
    case "$MODE" in
        screen|full|fullscreen) _cmd="screenshot-fullscreen" ;;
        window) _cmd="screenshot-window" ;;
        area|region) _cmd="screenshot-region" ;;
        annotate) _cmd="annotate" ;;
    esac
    canopy msg "$_cmd" "$@"
}

save_via_grim() {
    _dir="$(screen_dir)"
    mkdir -p "$_dir"
    _file="$_dir/$(date +%Y-%m-%d_%H-%M-%S).png"
    case "$MODE" in
        screen|full|fullscreen)
            grim "$_file" ;;
        window)
            # No toplevel capture without the protocol; fall back to the output.
            grim "$_file" ;;
        *)
            _geom="$(slurp)" || exit 0
            grim -g "$_geom" "$_file" ;;
    esac
    printf '%s\n' "$_file"
}

if command -v canopy >/dev/null 2>&1 && canopy msg log-level-status >/dev/null 2>&1; then
    if save_via_shell "$@"; then
        exit 0
    fi
fi

if command -v grim >/dev/null 2>&1; then
    save_via_grim
    exit 0
fi

printf 'canopy-screenshot: no capture backend available (start Canopy, or install grim/slurp)\n' >&2
exit 1