<?xml version="1.0"?>
<labwc_config>

  <core>
    <window>
      <titlebar>
        <layout>iconify,max,close:</layout>
        <showTitle>yes</showTitle>
      </titlebar>
    </window>
    <decoration>server</decoration>
    <gap>0</gap>
    <primarySelection>yes</primarySelection>
    <reuseOutputMode>yes</reuseOutputMode>
  </core>

  <placement>
    <policy>automatic</policy>
  </placement>

  <theme>
    <name>canopy</name>
    <dropShadows>yes</dropShadows>
    <cornerRadius>10</cornerRadius>
    <font name="Inter" size="10" weight="semibold" slant="normal"/>
    <padding>
      <titlebar>
        <height>30</height>
        <paddingHeight>4</paddingHeight>
        <paddingWidth>6</paddingWidth>
      </titlebar>
    </padding>
    <menu>
      <border>1</border>
      <overlap>4</overlap>
      <titlebarHeight>28</titlebarHeight>
      <itemHeight>28</itemHeight>
    </menu>
    <osd>
      <margin>16</margin>
      <font name="Inter" size="10" weight="medium"/>
    </osd>
  </theme>

  <desktops>
    <names>
      <name>One</name>
      <name>Two</name>
      <name>Three</name>
      <name>Four</name>
    </names>
  </desktops>

  <resize>
    <drawContents>yes</drawContents>
    <popupShow>never</popupShow>
  </resize>

  <windowRules>
    <!-- Canopy's own surfaces are never decorated nor listed as windows. -->
    <windowRule identifier="canopy" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes"/>
    <windowRule title="Canopy" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes"/>
    <windowRule type="dialog" placement="center"/>
  </windowRules>

  <keyboard>
    <default/>
    <numlock>on</numlock>
    <layoutScope>global</layoutScope>

    <!-- ── Canopy shell ────────────────────────────────────────────────────
         Super on its own opens the launcher. onRelease="yes" means the binding
         only fires when Super is pressed and released without another key, so
         Super+<key> shortcuts still reach their own binds. -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="canopy msg panel-toggle launcher"/>
    </keybind>
    <keybind key="W-s">
      <action name="Execute" command="canopy msg panel-toggle control-center"/>
    </keybind>
    <keybind key="W-n">
      <action name="Execute" command="canopy msg panel-toggle notifications"/>
    </keybind>
    <keybind key="W-v">
      <action name="Execute" command="canopy msg panel-toggle clipboard"/>
    </keybind>
    <keybind key="W-comma">
      <action name="Execute" command="canopy msg settings-open"/>
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="canopy msg session lock"/>
    </keybind>
    <keybind key="W-Escape">
      <action name="Execute" command="canopy msg session lock"/>
    </keybind>

    <!-- ── Applications ──────────────────────────────────────────────────── -->
    <keybind key="W-Return">
      <action name="Execute" command="sh -c 'xdg-terminal-exec 2>/dev/null || alacritty 2>/dev/null || kitty 2>/dev/null || foot'" />
    </keybind>
    <keybind key="W-q">
      <action name="Close"/>
    </keybind>

    <!-- ── Windows ───────────────────────────────────────────────────────── -->
    <keybind key="W-m">
      <action name="ToggleMaximize"/>
    </keybind>
    <keybind key="W-f">
      <action name="ToggleFullscreen"/>
    </keybind>
    <keybind key="W-S-m">
      <action name="ToggleMaximize" direction="horizontal"/>
    </keybind>
    <keybind key="W-S-f">
      <action name="ToggleMaximize" direction="vertical"/>
    </keybind>
    <keybind key="W-Left">
      <action name="ToggleSnapToEdge" direction="left"/>
    </keybind>
    <keybind key="W-Right">
      <action name="ToggleSnapToEdge" direction="right"/>
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleSnapToEdge" direction="up"/>
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify"/>
    </keybind>
    <keybind key="W-S-Left">
      <action name="MoveToEdge" direction="left"/>
    </keybind>
    <keybind key="W-S-Right">
      <action name="MoveToEdge" direction="right"/>
    </keybind>
    <keybind key="W-S-Up">
      <action name="MoveToEdge" direction="up"/>
    </keybind>
    <keybind key="W-S-Down">
      <action name="MoveToEdge" direction="down"/>
    </keybind>
    <keybind key="W-a">
      <action name="MoveToOutput" direction="right"/>
    </keybind>
    <keybind key="W-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>
    <keybind key="W-d">
      <action name="ToggleShowDesktop"/>
    </keybind>

    <!-- ── Workspaces ────────────────────────────────────────────────────── -->
    <keybind key="W-1"><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4"/></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="yes"/></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="yes"/></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="yes"/></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="yes"/></keybind>
    <keybind key="W-C-Left">
      <action name="GoToDesktop" to="left"/>
    </keybind>
    <keybind key="W-C-Right">
      <action name="GoToDesktop" to="right"/>
    </keybind>

    <!-- ── Screenshots (Canopy's own capture stack) ───────────────────────── -->
    <keybind key="Print">
      <action name="Execute" command="canopy msg screenshot-region"/>
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="canopy msg screenshot-fullscreen"/>
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute" command="canopy msg screenshot-window"/>
    </keybind>
    <keybind key="W-S-a">
      <action name="Execute" command="canopy msg annotate"/>
    </keybind>

    <!-- ── Media and hardware keys ───────────────────────────────────────── -->
    <keybind key="XF86_AudioRaiseVolume">
      <action name="Execute" command="canopy msg volume-up"/>
    </keybind>
    <keybind key="XF86_AudioLowerVolume">
      <action name="Execute" command="canopy msg volume-down"/>
    </keybind>
    <keybind key="XF86_AudioMute">
      <action name="Execute" command="canopy msg volume-mute"/>
    </keybind>
    <keybind key="XF86_MonBrightnessUp">
      <action name="Execute" command="canopy msg brightness-up"/>
    </keybind>
    <keybind key="XF86_MonBrightnessDown">
      <action name="Execute" command="canopy msg brightness-down"/>
    </keybind>
    <keybind key="XF86_AudioPlay">
      <action name="Execute" command="canopy msg media play-pause"/>
    </keybind>
    <keybind key="XF86_AudioNext">
      <action name="Execute" command="canopy msg media next"/>
    </keybind>
    <keybind key="XF86_AudioPrev">
      <action name="Execute" command="canopy msg media previous"/>
    </keybind>
  </keyboard>

  <mouse>
    <default/>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu"/>
      </mousebind>
    </context>
  </mouse>

</labwc_config>