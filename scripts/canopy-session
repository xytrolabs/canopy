#!/bin/sh
# canopy-session — start a Canopy desktop session.
#
# This is what the display manager runs, and what you run from a TTY. It owns
# the session environment, starts the Labwc compositor and lets the shell come
# up on its own (labwc/autostart), so the shell can be restarted without
# tearing the session down.
#
#   canopy-session            start (or take over) the session
#   canopy-session --nested   run nested inside an existing Wayland session
#   canopy-session --compositor mangowc
#   canopy-session --compositor umbriel
#
# labwc is the default compositor. MangoWC is a second, beta session that runs
# the same shell - it does not replace labwc anywhere. `umbriel` is Canopy's own
# compositor fork (compositor/ in the source tree): it is what the identity work
# is heading towards, but it is not the default until it passes its checklist.
# See docs/COMPOSITOR_FORK.md.
set -eu

# --------------------------------------------------------------- compositor --
COMPOSITOR="${CANOPY_COMPOSITOR:-labwc}"
PRINT_LIST=0
for arg in "$@"; do
    case "$arg" in
        --compositor=*) COMPOSITOR="${arg#--compositor=}" ;;
        --mangowc) COMPOSITOR="mangowc" ;;
        --list-compositors) PRINT_LIST=1 ;;
    esac
done
# --compositor VALUE (space separated) needs a small manual scan.
_prev=""
for arg in "$@"; do
    if [ "$_prev" = "--compositor" ]; then COMPOSITOR="$arg"; fi
    _prev="$arg"
done

compositor_binary() {
    case "$1" in
        labwc) printf 'labwc\n' ;;
        mangowc|mango) printf 'mangowc\n' ;;
        umbriel|canopywc) canopywc_binary ;;
        *) printf '\n' ;;
    esac
}

# The fork is built as `canopywc` once it has been rebranded and as plain
# `umbriel` before that; a source checkout also has it in build-compositor/.
canopywc_binary() {
    for candidate in canopywc umbriel; do
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    if [ -n "${CANOPY_COMPOSITOR_BUILD:-}" ] && [ -x "$CANOPY_COMPOSITOR_BUILD/umbriel" ]; then
        printf '%s\n' "$CANOPY_COMPOSITOR_BUILD/umbriel"
        return 0
    fi
    printf 'canopywc\n'
}

if [ "$PRINT_LIST" -eq 1 ]; then
    printf 'labwc    default session, server-side decorations\n'
    printf 'mangowc  beta tiling session (package: mangowm)\n'
    printf 'umbriel  beta Canopy compositor fork (compositor/, not yet default)\n'
    exit 0
fi

COMPOSITOR_BIN="$(compositor_binary "$COMPOSITOR")"
if [ -z "$COMPOSITOR_BIN" ]; then
    printf 'canopy-session: unknown compositor "%s" (use labwc, mangowc or umbriel)\n' "$COMPOSITOR" >&2
    exit 2
fi

# --------------------------------------------------------------- environment --
# Exported here rather than in a profile snippet so every process started from
# the session - applications, portals, the shell's own children - sees the same
# desktop identity.
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Canopy}"
export XDG_SESSION_DESKTOP=canopy
export DESKTOP_SESSION=canopy
export XDG_SESSION_TYPE=wayland

# Toolkit backends. Explicit is better than "whatever the toolkit guesses".
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

# File choosers and dialogs follow the desktop theme through xdg-desktop-portal.
export XDG_DESKTOP_PORTAL_DIR="${XDG_DESKTOP_PORTAL_DIR:-/usr/share/xdg-desktop-portal}"

# Qt widgets (any Qt app) get the Canopy colours and icon theme.
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/qt6ct/qt6ct.conf" ]; then
    export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-qt6ct}"
fi

# Fonts shipped by Canopy, if this is a user install.
if [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/fonts/canopy" ]; then
    export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:${XDG_DATA_HOME:-$HOME/.local/share}"
fi

# ---------------------------------------------------------------- compositor --
NESTED=""
for arg in "$@"; do
    case "$arg" in
        --nested|-n) NESTED=1 ;;
    esac
done

# Running from a terminal inside an existing desktop? Then this is a nested
# session, not a new one: Labwc must render into a window on the running
# compositor instead of trying to become the display server (which fails on the
# VT and collides with the existing XWayland socket).
if [ -z "$NESTED" ] && { [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; }; then
    NESTED=1
fi

if [ -n "$NESTED" ]; then
    # wlroots must use the Wayland backend; auto-detection can pick DRM when
    # DISPLAY is set, which hangs waiting for a seat it will never get.
    export WLR_BACKENDS="${WLR_BACKENDS:-wayland}"
    printf 'canopy-session: starting nested inside %s\n' "${WAYLAND_DISPLAY:-$DISPLAY}"
    printf '  this is a window inside your current desktop, not a login session\n'
    printf '  for the real session: log out and choose Canopy, or run this from a TTY\n'
fi

if ! command -v "$COMPOSITOR_BIN" >/dev/null 2>&1; then
    printf 'canopy-session: %s is not installed\n' "$COMPOSITOR_BIN" >&2
    case "$COMPOSITOR" in
        mangowc) printf '  install it with your package manager (Arch: mangowm)\n' >&2 ;;
        umbriel|canopywc)
            printf '  build it from the source tree: sh scripts/build-compositor.sh\n' >&2
            printf '  then: CANOPY_COMPOSITOR_BUILD=$PWD/build-compositor %s --compositor umbriel\n' "$0" >&2
            ;;
        *) printf '  install it with your package manager, or run: sh scripts/deps.sh plan\n' >&2 ;;
    esac
    exit 1
fi

# Only one shell per compositor. A second instance would draw a second panel
# and a second set of tray icons. This must NOT run in nested mode: the host
# session's shell is a real session, and killing it takes the user's desktop
# down with it.
if [ -z "$NESTED" ]; then
    pkill -x canopy 2>/dev/null || true
    sleep 0.3
fi

if [ -n "$NESTED" ] && [ "$COMPOSITOR" = "labwc" ]; then
    exec labwc -S 'canopy' -t 'Canopy (nested)'
fi

if [ -n "$NESTED" ]; then
    case "$COMPOSITOR" in
        mangowc|mango)
            # Tiling compositors take their startup command from their own
            # config, so there is no -S equivalent to pass here.
            exec "$COMPOSITOR_BIN"
            ;;
    esac
fi

# ------------------------------------------------------------ first login ----
# A system install (sudo) cannot write into the user's home, so the Canopy
# defaults are installed to /usr/local/share/canopy/config.toml and
# /etc/xdg/canopy/config.toml. Nobody's config.toml means the shell would fall
# back to its built-in palette and layout - i.e. it would not look like Canopy
# at all. Seed the user copy once, then never touch it again.
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
if [ ! -f "$CONFIG_HOME/canopy/config.toml" ]; then
    for candidate in \
        /etc/xdg/canopy/config.toml \
        /usr/local/share/canopy/config.toml \
        /usr/share/canopy/config.toml
    do
        if [ -f "$candidate" ]; then
            mkdir -p "$CONFIG_HOME/canopy"
            cp "$candidate" "$CONFIG_HOME/canopy/config.toml"
            printf 'canopy-session: seeded %s from %s\n' \
                "$CONFIG_HOME/canopy/config.toml" "$candidate"
            break
        fi
    done
fi

# Session: labwc runs ~/.config/labwc/autostart, which starts the shell. When
# that file is missing or does not mention canopy, pass the shell as the startup
# command instead - passing both would run two shells, which is exactly what
# produces a duplicated panel and a duplicated set of tray icons.
AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/labwc/autostart"
if [ "$COMPOSITOR" = "labwc" ] && [ -f "$AUTOSTART" ] && grep -q 'canopy' "$AUTOSTART" 2>/dev/null; then
    exec labwc -t Canopy
fi

if [ "$COMPOSITOR" = "labwc" ]; then
    exec labwc -S 'canopy' -t Canopy
fi

# ------------------------------------------------------------------ umbriel --
# Canopy's compositor fork. It starts the shell through `autostart` in its own
# TOML config and exports the IPC socket path, which the shell's backend picks
# up. Seed a config on first use and make sure the shell is in it; never touch
# the rest of a file the user has edited.
if [ "$COMPOSITOR" = "umbriel" ] || [ "$COMPOSITOR" = "canopywc" ]; then
    WC_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/umbriel/config.toml"
    if [ ! -f "$WC_CONFIG" ]; then
        for candidate in \
            /usr/local/share/canopy/umbriel/config.toml \
            /usr/share/canopy/umbriel/config.toml
        do
            if [ -f "$candidate" ]; then
                mkdir -p "$(dirname "$WC_CONFIG")"
                cp "$candidate" "$WC_CONFIG"
                printf 'canopy-session: seeded %s from %s\n' "$WC_CONFIG" "$candidate"
                break
            fi
        done
    fi
    mkdir -p "$(dirname "$WC_CONFIG")"
    [ -f "$WC_CONFIG" ] || : > "$WC_CONFIG"
    if ! grep -q '^[[:space:]]*autostart[[:space:]]*=' "$WC_CONFIG" 2>/dev/null; then
        if grep -q '^\[general\]' "$WC_CONFIG" 2>/dev/null; then
            sed -i '/^\[general\]/a autostart = ["canopy"]' "$WC_CONFIG"
        else
            printf '\n[general]\nautostart = ["canopy"]\n' >> "$WC_CONFIG"
        fi
        printf 'canopy-session: added the shell to autostart in %s\n' "$WC_CONFIG"
    fi
    exec "$COMPOSITOR_BIN"
fi

# ------------------------------------------------------------------ mangowc --
# MangoWC starts the shell through `exec-once=` in its own config, and exports
# MANGO_INSTANCE_SIGNATURE so the shell can reach it over the compositor socket.
# Seed the config on first use; never overwrite an edited one.
MANGO_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/mango/config.conf"
if [ ! -f "$MANGO_CONFIG" ]; then
    for candidate in \
        /usr/local/share/canopy/mangowc/config.conf \
        /usr/share/canopy/mangowc/config.conf
    do
        if [ -f "$candidate" ]; then
            mkdir -p "$(dirname "$MANGO_CONFIG")"
            cp "$candidate" "$MANGO_CONFIG"
            printf 'canopy-session: seeded %s from %s\n' "$MANGO_CONFIG" "$candidate"
            break
        fi
    done
fi

if [ ! -f "$MANGO_CONFIG" ]; then
    printf 'canopy-session: no MangoWC config found\n' >&2
    printf '  run sudo sh scripts/install.sh --with-mangowc to install the Canopy one\n' >&2
    exit 1
fi

exec "$COMPOSITOR_BIN"