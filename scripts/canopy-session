#!/bin/sh
# canopy-session — start a Canopy desktop session.
#
# This is what the display manager runs, and what you run from a TTY. It owns
# the session environment, starts the Labwc compositor and lets the shell come
# up on its own (labwc/autostart), so the shell can be restarted without
# tearing the session down.
#
#   canopy-session            start (or take over) the session
#   canopy-session --nested   run nested inside an existing Wayland session
set -eu

# --------------------------------------------------------------- environment --
# Exported here rather than in a profile snippet so every process started from
# the session - applications, portals, the shell's own children - sees the same
# desktop identity.
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Canopy}"
export XDG_SESSION_DESKTOP=canopy
export DESKTOP_SESSION=canopy
export XDG_SESSION_TYPE=wayland

# Toolkit backends. Explicit is better than "whatever the toolkit guesses".
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

# File choosers and dialogs follow the desktop theme through xdg-desktop-portal.
export XDG_DESKTOP_PORTAL_DIR="${XDG_DESKTOP_PORTAL_DIR:-/usr/share/xdg-desktop-portal}"

# Qt widgets (any Qt app) get the Canopy colours and icon theme.
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/qt6ct/qt6ct.conf" ]; then
    export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-qt6ct}"
fi

# Fonts shipped by Canopy, if this is a user install.
if [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/fonts/canopy" ]; then
    export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:${XDG_DATA_HOME:-$HOME/.local/share}"
fi

# ---------------------------------------------------------------- compositor --
NESTED=""
for arg in "$@"; do
    case "$arg" in
        --nested|-n) NESTED=1 ;;
    esac
done

if ! command -v labwc >/dev/null 2>&1; then
    printf 'canopy-session: labwc is not installed\n' >&2
    printf '  install it with your package manager, or run: sh scripts/deps.sh plan\n' >&2
    exit 1
fi

# Only one shell. A second instance would draw a second panel and a second set
# of tray icons, so clear stale processes before the compositor starts.
pkill -x canopy 2>/dev/null || true
sleep 0.3

if [ -n "$NESTED" ]; then
    # Nested: useful for development inside a running session.
    exec labwc -S 'canopy' -t 'Canopy (nested)'
fi

# Session: labwc runs ~/.config/labwc/autostart, which starts the shell. When
# that file is missing or does not mention canopy, pass the shell as the startup
# command instead - passing both would run two shells, which is exactly what
# produces a duplicated panel and a duplicated set of tray icons.
AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/labwc/autostart"
if [ -f "$AUTOSTART" ] && grep -q 'canopy' "$AUTOSTART" 2>/dev/null; then
    exec labwc -t Canopy
fi

exec labwc -S 'canopy' -t Canopy